generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "clientes", "processos", "financeiro", "acervo"]
}

enum Role {
  SOCIO
  FUNCIONARIO
  CLIENTE

  @@schema("auth")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(SOCIO)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@schema("auth")
}

// Refresh tokens são opacos (não JWT) para poderem ser revogados no banco;
// armazenamos só o hash SHA-256, nunca o valor em texto puro.
model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@schema("auth")
}

enum EmpresaStatus {
  ATIVA
  INATIVA
  SUSPENSA

  @@schema("clientes")
}

enum NaturezaJuridica {
  LTDA
  SA
  EI
  SOCIEDADE_SIMPLES
  MEI
  COOPERATIVA
  ASSOCIACAO

  @@schema("clientes")
}

enum PorteEmpresa {
  ME
  EPP
  DEMAIS

  @@schema("clientes")
}

enum OrgaoRegistro {
  OAB
  JUNTA_COMERCIAL
  CARTORIO

  @@schema("clientes")
}

// Regime tributário de verdade (distinto de NaturezaJuridica) — 1º nível da
// árvore de decisão do Motor de Obrigações (Cartilha SEIKA).
enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL

  @@schema("clientes")
}

enum LucroRealApuracao {
  TRIMESTRAL
  ANUAL_ESTIMATIVA

  @@schema("clientes")
}

// 2º nível da árvore de decisão — distinto de tipoAtividade (texto livre/CNAE).
enum NaturezaAtividade {
  SERVICO
  COMERCIO
  MISTA

  @@schema("clientes")
}

model Empresa {
  id           String        @id @default(uuid())
  razaoSocial  String
  nomeFantasia String?
  // CNPJ normalizado, só dígitos (14 chars), sem máscara — formata na borda (frontend).
  cnpj         String        @unique
  status       EmpresaStatus @default(ATIVA)
  email        String?
  telefone     String?
  // Desde quando a empresa é cliente da Seika (início das obrigações) —
  // distinto de createdAt, que é só quando o cadastro foi digitado no sistema.
  clienteDesde         DateTime?
  capitalSocialCentavos Int?
  inscricaoMunicipal   String?
  inscricaoEstadual    String?
  nire                 String?
  enderecoLogradouro   String?
  enderecoNumero       String?
  enderecoComplemento  String?
  enderecoBairro       String?
  enderecoCidade       String?
  enderecoUf           String?
  enderecoCep          String?
  temFilial            Boolean          @default(false)
  naturezaJuridica     NaturezaJuridica?
  porte                PorteEmpresa?
  orgaoRegistro        OrgaoRegistro?
  tipoAtividade        String?
  // Entrada da árvore de decisão do Motor de Obrigações (Cartilha SEIKA).
  regimeTributario     RegimeTributario?
  // Só relevante quando regimeTributario = LUCRO_REAL (pergunta obrigatória
  // da seção 5 da cartilha).
  lucroRealApuracao    LucroRealApuracao?
  naturezaAtividade    NaturezaAtividade?
  // Características fiscais (checklist da seção 9 da cartilha) — alimentam
  // o motor de geração de obrigações (Fase C). "Possui movimento no período"
  // fica de fora de propósito: varia todo mês, não é característica fixa.
  possuiEmpregados          Boolean @default(false)
  possuiProLabore           Boolean @default(false)
  possuiAutonomosRpa        Boolean @default(false)
  contribuinteIcms          Boolean @default(false)
  contribuinteIss           Boolean @default(false)
  contribuinteIpi           Boolean @default(false)
  possuiIcmsSt              Boolean @default(false)
  possuiDifal               Boolean @default(false)
  possuiAntecipacaoTributaria Boolean @default(false)
  possuiRetencoesFederais   Boolean @default(false)
  possuiRetencaoInss        Boolean @default(false)
  possuiRetencaoIss         Boolean @default(false)
  possuiCprb                Boolean @default(false)
  sujeitoFatorR             Boolean @default(false)
  possuiSstObrigatorio      Boolean @default(false)
  // Só o link onde o certificado está guardado (Drive/cofre externo) + a
  // data de vencimento — igual à decisão de segurança do Acervo (Fase 5):
  // o sistema nunca armazena o arquivo do certificado em si.
  certificadoDigitalUrl        String?
  certificadoDigitalVencimento DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  licencas     Licenca[]
  sociosAdministradores SocioAdministrador[]
  filiais      Filial[]

  @@schema("clientes")
}

model SocioAdministrador {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  cpf       String?
  email     String?
  telefone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@schema("clientes")
}

model Filial {
  id                  String   @id @default(uuid())
  empresaId           String
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome                String
  cnpj                String   @unique
  enderecoLogradouro  String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String?
  enderecoCep         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([empresaId])
  @@schema("clientes")
}

enum LicencaStatus {
  VALIDA
  VENCIDA
  EM_RENOVACAO

  @@schema("clientes")
}

model Licenca {
  id        String        @id @default(uuid())
  empresaId String
  empresa   Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo      String
  numero    String?
  status    LicencaStatus @default(VALIDA)
  validade  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([empresaId])
  @@schema("clientes")
}

// Status compartilhado por Processo e Obrigação (mesmo fluxo do sistema antigo).
enum StatusTarefa {
  A_FAZER
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  CONCLUIDO

  @@schema("processos")
}

enum Setor {
  LEGALIZACAO
  CONTABIL
  FISCAL
  DEPARTAMENTO_PESSOAL
  TI
  MARKETING
  OPERACAO

  @@schema("processos")
}

enum DescontoTipo {
  REAIS
  PERCENTUAL

  @@schema("processos")
}

// empresaId/owner são ids de outros módulos (Clientes/Auth), validados via
// chamada ao service deles — sem FK cross-schema, pra manter o módulo
// extraível no futuro.
model Processo {
  id                 String        @id @default(uuid())
  empresaId          String
  owner              String
  setor              Setor
  nome               String
  status             StatusTarefa  @default(A_FAZER)
  valorInicialCentavos Int
  descontoTipo       DescontoTipo  @default(REAIS)
  descontoCentavos   Int?
  descontoPercentual Float?
  valorFinalCentavos Int
  prazo              DateTime
  vencimentoCobranca DateTime
  descricao          String?
  coraSolicitado     Boolean       @default(false)
  concluidoEm        DateTime?
  createdBy          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([empresaId])
  @@index([owner])
  @@schema("processos")
}

// Status próprio de Obrigacao (distinto de StatusTarefa, que Processo
// continua usando — são ciclos de vida diferentes). "Vencido" (interno ou
// legal) não é um valor gravado aqui — é calculado na view comparando o
// status atual com a data de hoje, igual a `Cobranca.statusComputado`.
enum StatusObrigacao {
  AGUARDANDO_DOCUMENTOS
  EM_ANALISE
  EM_PROCESSAMENTO
  EM_CONFERENCIA
  CONCLUIDA
  NAO_APLICAVEL

  @@schema("processos")
}

model Obrigacao {
  id        String          @id @default(uuid())
  empresaId String?
  owner     String
  titulo    String
  // Prazo interno Seika — o que toda a UI já usa pra ordenar/cobrar.
  prazo     DateTime
  status    StatusObrigacao @default(AGUARDANDO_DOCUMENTOS)
  notas     String?
  // Preenchidos só quando a obrigação vem do Motor de Obrigações (Fase C) —
  // null quando é uma obrigação manual/avulsa, como sempre funcionou.
  templateId  String?
  competencia String? // "YYYY-MM"
  departamento Setor?
  prazoLegal   DateTime?
  semMovimento Boolean   @default(false)
  // "gerado:<templateId>:<empresaId>:<competencia>" — garante que o motor
  // nunca duplica a mesma obrigação pra mesma empresa/competência (mesmo
  // espírito do `chaveMensal` de Mensalidade→Cobranca).
  chaveGeracao String?  @unique
  createdBy String
  updatedBy String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([empresaId])
  @@index([owner])
  @@index([templateId])
  @@schema("processos")
}

enum Periodicidade {
  MENSAL
  TRIMESTRAL
  ANUAL
  EVENTUAL

  @@schema("processos")
}

// Catálogo de regras do Motor de Obrigações (Cartilha SEIKA) — cruza regime
// tributário + natureza da atividade + características da empresa pra saber
// quais obrigações se aplicam a cada cliente. Fase C usa este catálogo pra
// gerar as instâncias reais de `Obrigacao` por competência.
//
// Os 15 campos `exigeX` espelham 1:1 os 15 booleanos de características
// fiscais do model `Empresa` (módulo clientes) — o motor casa
// `exigeEmpregados` com `possuiEmpregados`, `exigeIcms` com
// `contribuinteIcms`, `exigeFatorR` com `sujeitoFatorR`, etc. `false` = não é
// condição de habilitação pra este template (não exige nada); `true` = só
// habilita se a empresa também tiver essa característica marcada.
model ObrigacaoTemplate {
  id     String @id @default(uuid())
  codigo String @unique
  nome   String
  // Como a cartilha agrupa na tabela de origem: Federal, Estadual, Municipal,
  // Retenções, Pessoal, Anual, Contábil, Documentos, Estoque, IRPJ/CSLL...
  grupo        String
  // Responsável interno (reaproveita o enum já usado em Processo).
  departamento Setor

  regimesAplicaveis    RegimeTributario[]
  atividadesAplicaveis NaturezaAtividade[]
  // Só relevante quando LUCRO_REAL está entre os regimes aplicáveis — se
  // preenchido, só habilita pra empresas com esse valor exato em
  // Empresa.lucroRealApuracao (null = não filtra por isso).
  exigeLucroRealApuracao LucroRealApuracao?

  periodicidade    Periodicidade
  // Em quais meses do ano (1-12) a competência desta obrigação cai. Mensal =
  // todos os 12; trimestral/anual = só os meses de fechamento relevantes.
  mesesCompetencia Int[]
  regraCompetencia String? // texto livre, ex: "Mês anterior", "Trimestre anterior"

  // Prazo legal = dia `prazoLegalDia` do mês (competência + `prazoLegalMesesApos`).
  // V1 pragmático (sem calendário de feriados/UF) — sempre editável pelo
  // sócio; ver nota técnica da própria cartilha.
  prazoLegalMesesApos   Int     @default(1)
  prazoLegalDia         Int     @default(20)
  prazoLegalDescricao   String? // texto livre quando a regra não cabe em dia+offset
  prazoInternoDiasAntes Int     @default(5)

  // "Possui movimento no período" não entra aqui — é verificado por
  // instância/competência (Fase C), não é característica fixa do template.
  exigeMovimento              Boolean @default(false)
  exigeEmpregados             Boolean @default(false)
  exigeProLabore              Boolean @default(false)
  exigeAutonomosRpa           Boolean @default(false)
  exigeIcms                   Boolean @default(false)
  exigeIss                    Boolean @default(false)
  exigeIpi                    Boolean @default(false)
  exigeIcmsSt                 Boolean @default(false)
  exigeDifal                  Boolean @default(false)
  exigeAntecipacaoTributaria  Boolean @default(false)
  exigeRetencoesFederais      Boolean @default(false)
  exigeRetencaoInss           Boolean @default(false)
  exigeRetencaoIss            Boolean @default(false)
  exigeCprb                   Boolean @default(false)
  exigeFatorR                 Boolean @default(false)
  exigeSstObrigatorio         Boolean @default(false)

  geraGuia      Boolean   @default(false)
  dependencia   String?
  vigenciaInicio DateTime?
  vigenciaFim    DateTime?
  observacoes    String?
  // Permite publicar o catálogo aos poucos (seed inicial entra desativado
  // até um sócio conferir contra a legislação vigente).
  ativo          Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo])
  @@schema("processos")
}

// Responsável padrão por departamento — usado automaticamente pelo motor de
// geração quando o template daquela obrigação tem `departamento` configurado
// aqui, em vez do "Responsável padrão" escolhido na hora de gerar (que vira
// só o fallback dos departamentos sem override). ownerId é id de User
// (módulo Auth), validado via service, sem FK cross-schema.
model ResponsavelDepartamento {
  departamento Setor    @id
  ownerId      String
  updatedBy    String
  updatedAt    DateTime @updatedAt

  @@schema("processos")
}

enum TipoCobranca {
  ESPORADICO
  MENSAL
  AJUSTE

  @@schema("financeiro")
}

enum StatusCobranca {
  PENDENTE
  PAGO

  @@schema("financeiro")
}

enum FormaPagamento {
  PIX
  BOLETO
  TRANSFERENCIA
  DINHEIRO
  CARTAO

  @@schema("financeiro")
}

// "Atrasado" não é um status gravado — é calculado (status=PENDENTE e
// vencimento < hoje), igual ao sistema antigo. empresaId/processoId
// validados via service de outros módulos, sem FK cross-schema.
model Cobranca {
  id                    String          @id @default(uuid())
  empresaId             String
  processoId            String?
  descricao             String
  valorCentavos         Int
  vencimento            DateTime
  tipo                  TipoCobranca
  // "monthly:<empresaId>:<competencia>" só quando tipo=MENSAL — garante uma
  // cobrança por empresa/mês (NULL não conflita com outro NULL no Postgres).
  chaveMensal           String?         @unique
  status                StatusCobranca  @default(PENDENTE)
  valorPagoCentavos     Int?
  pagoEm                DateTime?
  formaPagamento        FormaPagamento?
  observacao            String?
  recebidoPor           String?
  coraSolicitado        Boolean         @default(false)
  coraStatus            String?
  estornoMotivo         String?
  estornoPor            String?
  estornoEm             DateTime?
  estornoPagoEmAnterior DateTime?
  createdBy             String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([empresaId])
  @@index([status])
  @@schema("financeiro")
}

// Configuração de honorário recorrente por empresa — as cobranças do mês
// corrente são geradas sob demanda (ver financeiroService), não por cron.
model Mensalidade {
  id            String   @id @default(uuid())
  empresaId     String   @unique
  valorCentavos Int
  diaVencimento Int
  ativaDesde    DateTime
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("financeiro")
}

model Despesa {
  id            String         @id @default(uuid())
  descricao     String
  categoria     String
  valorCentavos Int
  competencia   DateTime
  status        StatusCobranca @default(PENDENTE)
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@schema("financeiro")
}

// Trilha de auditoria do módulo financeiro. Append-only POR CONVENÇÃO DE
// CÓDIGO (o app nunca chama update/delete nela) — a garantia de verdade a
// nível de banco (revogar UPDATE/DELETE da role de runtime) fica pra Fase 8,
// quando migrations e runtime passam a usar credenciais separadas.
model AuditLogFinanceiro {
  id         String   @id @default(uuid())
  entidade   String
  entidadeId String
  acao       String
  ator       String
  detalhes   Json?
  createdAt  DateTime @default(now())

  @@index([entidade, entidadeId])
  @@schema("financeiro")
}

enum TipoMaterial {
  LIVRO
  VIDEO
  DOCUMENTO
  FOTO
  PLANILHA
  APRESENTACAO
  SITE

  @@schema("acervo")
}

// Acervo é só metadados + link externo (Google Drive, em geral) — o sistema
// nunca guarda nem transporta o arquivo em si, de propósito (ver decisão de
// segurança da Fase 5: zero credencial de terceiro guardada aqui).
model MaterialAcervo {
  id        String       @id @default(uuid())
  titulo    String
  area      String
  tipo      TipoMaterial @default(DOCUMENTO)
  categoria String?
  url       String
  descricao String?
  createdBy String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([area])
  @@schema("acervo")
}

